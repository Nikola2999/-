from math import sqrt

class Point:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def move(self, dx, dy):
        self.x += dx
        self.y += dy

    def coordinates(self):
        print("Координати:", self.x, self.y)

p = Point(0, 0)

while True:
    command = input("Натисни w/a/s/d или q за край: ")

    if command == "w":
        p.move(0, 1)
    elif command == "s":
        p.move(0, -1)
    elif command == "a":
        p.move(-1, 0)
    elif command == "d":
        p.move(1, 0)
    elif command == "q":
        break

    p.coordinates()
